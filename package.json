{
  "name": "save-web-as-pdf",
  "version": "0.5.5",
  "private": true,
  "license": "MIT",
  "description": "A local-first Chrome extension that saves the current webpage as a searchable PDF using the longest practical pages.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:filename": "node scripts/test-filename.mjs",
    "test:export": "node scripts/test-export-logic.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:settings": "node scripts/test-settings-compat.mjs",
    "test:popup": "node scripts/test-popup.mjs",
    "test:extension-runtime": "node scripts/test-extension-runtime.mjs",
    "test:pdf-integration": "node scripts/test-last-page-integration.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "package": "node scripts/package.mjs",
    "check": "node scripts/check.mjs",
    "test:page-layout": "node scripts/test-page-layout-integration.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289"
  }
}
