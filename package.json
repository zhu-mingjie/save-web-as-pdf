{
  "name": "save-web-as-pdf",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first Chrome extension that saves the current webpage as one continuous, searchable PDF page.",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:filename": "node scripts/test-filename.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "package": "node scripts/package.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
