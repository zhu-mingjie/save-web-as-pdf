{
  "manifest_version": 3,
  "name": "Save Web as PDF",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Save the current webpage as one continuous, searchable PDF page.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "downloads",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save Web as PDF",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
